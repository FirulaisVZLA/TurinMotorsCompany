# Copia este archivo a ".env" y completa los valores reales (nunca subir
# ".env" al repositorio -- ya esta en .gitignore).
#
# Supabase: Project Settings -> API en supabase.com
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Formspree: un formulario por tipo de envio (para no compartir el limite
# mensual del plan gratis). El ID es la parte final de la URL que da
# Formspree al crear el formulario: https://formspree.io/f/XXXXXXXX
PUBLIC_FORMSPREE_QUOTE_ID=
PUBLIC_FORMSPREE_REVIEWS_ID=
PUBLIC_FORMSPREE_APPOINTMENTS_ID=
PUBLIC_FORMSPREE_PARTS_ID=
