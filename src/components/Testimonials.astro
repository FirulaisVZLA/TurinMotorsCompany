---
import { testimonials as placeholderTestimonials } from "../data/testimonials";
import { getApprovedReviews } from "../lib/reviews";

// Respaldo por correo (además de guardarse en la tabla `resenas` de
// Supabase), mismo patrón que el resto de formularios del sitio.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_REVIEWS_ID ?? "";
const formspreeEndpoint = formspreeId ? `https://formspree.io/f/${formspreeId}` : "";

// Reseñas reales aprobadas por el dueño (columna `aprobada` en Supabase).
// Mientras no haya ninguna aprobada todavía, se muestran los ejemplos de
// placeholder para que la sección no se vea vacía.
const approvedReviews = await getApprovedReviews();
const testimonials = approvedReviews.length > 0
  ? approvedReviews.map((r) => ({ name: r.nombre, text: r.comentario, rating: r.calificacion }))
  : placeholderTestimonials;
---

<section id="resenas" class="scroll-mt-20 py-16 px-4 sm:px-6 lg:px-8 border-t border-neutral-200">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-center text-2xl sm:text-3xl font-bold text-ink">
      Lo que dicen <span class="text-accent">nuestros clientes</span>
    </h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <article class="flex flex-col rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <div class="flex gap-1 text-accent" aria-label={`Calificación: ${t.rating} de 5 estrellas`}>
            {Array.from({ length: 5 }, (_, i) => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-5 w-5" fill={i < t.rating ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 2.5l2.34 4.74 5.23.76-3.79 3.69.9 5.21L10 14.4l-4.68 2.5.9-5.21-3.79-3.69 5.23-.76z" />
              </svg>
            ))}
          </div>
          <p class="mt-4 flex-1 text-sm text-ink-soft">"{t.text}"</p>
          <p class="mt-4 text-sm font-bold text-ink">{t.name}</p>
        </article>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-xl rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm sm:p-8">
      <h3 class="text-lg font-bold text-ink">Cuéntanos tu experiencia</h3>
      <p class="mt-1 text-sm text-ink-soft">Tu reseña se revisa antes de publicarse en el sitio.</p>

      <form id="review-form" class="mt-5 space-y-4" data-endpoint={formspreeEndpoint} novalidate>
        <div>
          <label for="rf-name" class="mb-1 block text-sm font-medium text-ink">
            Nombre <span class="text-accent" aria-hidden="true">*</span>
          </label>
          <input id="rf-name" name="nombre" type="text" required
            class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" />
        </div>

        <div>
          <span class="mb-1 block text-sm font-medium text-ink">
            Calificación <span class="text-accent" aria-hidden="true">*</span>
          </span>
          <div id="rf-stars" class="flex gap-1 text-neutral-300" role="radiogroup" aria-label="Calificación de 1 a 5 estrellas">
            {[1, 2, 3, 4, 5].map((n) => (
              <button type="button" data-star={n} role="radio" aria-checked="false" aria-label={`${n} estrella${n > 1 ? "s" : ""}`} class="transition hover:scale-110">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-7 w-7" fill="currentColor">
                  <path d="M10 2.5l2.34 4.74 5.23.76-3.79 3.69.9 5.21L10 14.4l-4.68 2.5.9-5.21-3.79-3.69 5.23-.76z" />
                </svg>
              </button>
            ))}
          </div>
          <input id="rf-rating" name="calificacion" type="hidden" value="" required />
        </div>

        <div>
          <label for="rf-comment" class="mb-1 block text-sm font-medium text-ink">
            Comentario <span class="text-accent" aria-hidden="true">*</span>
          </label>
          <textarea id="rf-comment" name="comentario" rows="3" required
            class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20"></textarea>
        </div>

        <button type="submit"
          class="w-full rounded-full bg-accent px-8 py-3 font-bold text-white transition hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-60">
          Enviar reseña
        </button>

        <p id="review-success" class="hidden rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-700" role="status">
          ¡Gracias por tu reseña!
        </p>
        <p id="review-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700" role="alert">
          No pudimos enviar tu reseña. Intenta de nuevo más tarde.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  import { supabase } from "../lib/supabase";

  const starButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-star]"));
  const ratingInput = document.getElementById("rf-rating") as HTMLInputElement | null;

  const paintStars = (value: number) => {
    starButtons.forEach((btn) => {
      const n = Number(btn.dataset.star);
      btn.classList.toggle("text-accent", n <= value);
      btn.classList.toggle("text-neutral-300", n > value);
      btn.setAttribute("aria-checked", String(n === value));
    });
  };

  starButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const value = Number(btn.dataset.star);
      if (ratingInput) ratingInput.value = String(value);
      paintStars(value);
    });
  });

  const form = document.getElementById("review-form") as HTMLFormElement | null;
  const success = document.getElementById("review-success");
  const errorMsg = document.getElementById("review-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!ratingInput?.value) {
      ratingInput?.setCustomValidity("Selecciona una calificación.");
      form.reportValidity();
      ratingInput?.setCustomValidity("");
      return;
    }
    if (!form.reportValidity()) return;

    const formData = new FormData(form);
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    success?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    const endpoint = form.dataset.endpoint;

    // Mismo patrón que el resto de formularios: se intenta guardar en
    // Supabase y enviar por Formspree en paralelo; con que uno funcione,
    // la reseña no se pierde.
    const supabaseInsert = supabase.from("resenas").insert({
      nombre: formData.get("nombre"),
      comentario: formData.get("comentario"),
      calificacion: Number(formData.get("calificacion")),
    });

    const formspreeSubmit = endpoint
      ? fetch(endpoint, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        }).then((response) => {
          if (!response.ok) throw new Error(`Formspree respondió ${response.status}`);
        })
      : Promise.reject(new Error("PUBLIC_FORMSPREE_REVIEWS_ID no configurado"));

    const [supabaseResult, formspreeResult] = await Promise.allSettled([supabaseInsert, formspreeSubmit]);

    if (supabaseResult.status === "rejected") {
      console.error("Error guardando la reseña en Supabase:", supabaseResult.reason);
    } else if (supabaseResult.value.error) {
      console.error("Error guardando la reseña en Supabase:", supabaseResult.value.error);
    }
    if (formspreeResult.status === "rejected") {
      console.error("Error enviando la reseña a Formspree:", formspreeResult.reason);
    }

    const okSupabase = supabaseResult.status === "fulfilled" && !supabaseResult.value.error;
    const okFormspree = formspreeResult.status === "fulfilled";

    if (okSupabase || okFormspree) {
      form.reset();
      if (ratingInput) ratingInput.value = "";
      paintStars(0);
      success?.classList.remove("hidden");
    } else {
      errorMsg?.classList.remove("hidden");
    }

    if (button) button.disabled = false;
  });
</script>
