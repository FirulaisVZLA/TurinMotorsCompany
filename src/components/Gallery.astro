---
import sharp from "sharp";
import path from "node:path";
import type { GalleryImage } from "../data/models";

interface Props {
  id: string;
  images: GalleryImage[];
}

const { id, images } = Astro.props;

// Alto tope de la foto grande (el ancho se deriva del aspect-ratio real de
// cada archivo, leido con sharp en tiempo de build -- asi el marco siempre
// coincide exacto con la foto, sin importar si es panoramica o no, y sin
// depender de trucos de CSS como w-fit que se rompen en columnas angostas
// como el layout de 2 columnas alternado de ModelSection).
const HEIGHT_CAP = "min(60vh, 26rem)";

const slides = await Promise.all(
  images.map(async (img) => {
    const filePath = path.join(process.cwd(), "public", img.src);
    const metadata = await sharp(filePath).metadata();
    const ratio = metadata.width && metadata.height ? metadata.width / metadata.height : 16 / 9;
    return { ...img, ratio };
  })
);
---

{slides.length > 0 && (
  <div class="gallery" data-gallery-id={id}>
    <div class="relative">
      {slides.map((img, i) => (
        <img
          src={img.src}
          alt={img.alt}
          class="gallery-slide mx-auto rounded-xl bg-neutral-100 shadow-sm object-contain"
          class:list={[i === 0 ? "block" : "hidden"]}
          style={`aspect-ratio: ${img.ratio}; max-height: ${HEIGHT_CAP}; max-width: 100%; width: auto; height: auto;`}
          data-index={i}
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))}

      {slides.length > 1 && (
        <>
          <button
            type="button"
            class="gallery-prev absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 shadow hover:bg-white"
            aria-label="Foto anterior"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            class="gallery-next absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 shadow hover:bg-white"
            aria-label="Foto siguiente"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}
    </div>

    {slides.length > 1 && (
      <div class="mt-3 grid grid-cols-5 sm:grid-cols-7 gap-2">
        {slides.map((img, i) => (
          <button
            type="button"
            class="gallery-thumb aspect-video overflow-hidden rounded-md border-2 shadow-sm transition-colors"
            class:list={[i === 0 ? "border-accent" : "border-transparent"]}
            data-index={i}
            aria-label={`Ver foto ${i + 1}`}
          >
            <img src={img.src} alt="" class="h-full w-full object-cover" loading="lazy" />
          </button>
        ))}
      </div>
    )}
  </div>
)}

<script>
  // Navegación de galería SOLO por clic (flechas y miniaturas) — nunca
  // auto-avance al pasar el mouse, el usuario controla cuánto ve cada foto.
  function setupGallery(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>(".gallery-slide"));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".gallery-thumb"));
    let current = 0;

    function show(index: number) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      slides[current]?.classList.add("hidden");
      slides[current]?.classList.remove("block");
      thumbs[current]?.classList.remove("border-accent");
      thumbs[current]?.classList.add("border-transparent");

      current = index;

      slides[current]?.classList.remove("hidden");
      slides[current]?.classList.add("block");
      thumbs[current]?.classList.add("border-accent");
      thumbs[current]?.classList.remove("border-transparent");
    }

    root.querySelector(".gallery-prev")?.addEventListener("click", () => show(current - 1));
    root.querySelector(".gallery-next")?.addEventListener("click", () => show(current + 1));
    thumbs.forEach((thumb, i) => thumb.addEventListener("click", () => show(i)));
  }

  document.querySelectorAll<HTMLElement>(".gallery").forEach(setupGallery);
</script>
