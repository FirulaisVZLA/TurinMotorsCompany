---
import type { GalleryImage } from "../data/models";

interface Props {
  id: string;
  images: GalleryImage[];
}

const { id, images } = Astro.props;
---

{images.length > 0 && (
  <div class="gallery" data-gallery-id={id}>
    <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-neutral-100">
      {images.map((img, i) => (
        <img
          src={img.src}
          alt={img.alt}
          class="gallery-slide absolute inset-0 h-full w-full object-contain transition-opacity duration-200"
          class:list={[i === 0 ? "opacity-100" : "opacity-0 pointer-events-none"]}
          data-index={i}
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))}

      {images.length > 1 && (
        <>
          <button
            type="button"
            class="gallery-prev absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 shadow hover:bg-white"
            aria-label="Foto anterior"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            class="gallery-next absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 shadow hover:bg-white"
            aria-label="Foto siguiente"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}
    </div>

    {images.length > 1 && (
      <div class="mt-3 grid grid-cols-5 sm:grid-cols-7 gap-2">
        {images.map((img, i) => (
          <button
            type="button"
            class="gallery-thumb aspect-video overflow-hidden rounded-md border-2 transition-colors"
            class:list={[i === 0 ? "border-accent" : "border-transparent"]}
            data-index={i}
            aria-label={`Ver foto ${i + 1}`}
          >
            <img src={img.src} alt="" class="h-full w-full object-cover" loading="lazy" />
          </button>
        ))}
      </div>
    )}
  </div>
)}

<script>
  // Navegación de galería SOLO por clic (flechas y miniaturas) — nunca
  // auto-avance al pasar el mouse, el usuario controla cuánto ve cada foto.
  function setupGallery(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>(".gallery-slide"));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".gallery-thumb"));
    let current = 0;

    function show(index: number) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      slides[current]?.classList.add("opacity-0", "pointer-events-none");
      slides[current]?.classList.remove("opacity-100");
      thumbs[current]?.classList.remove("border-accent");
      thumbs[current]?.classList.add("border-transparent");

      current = index;

      slides[current]?.classList.remove("opacity-0", "pointer-events-none");
      slides[current]?.classList.add("opacity-100");
      thumbs[current]?.classList.add("border-accent");
      thumbs[current]?.classList.remove("border-transparent");
    }

    root.querySelector(".gallery-prev")?.addEventListener("click", () => show(current - 1));
    root.querySelector(".gallery-next")?.addEventListener("click", () => show(current + 1));
    thumbs.forEach((thumb, i) => thumb.addEventListener("click", () => show(i)));
  }

  document.querySelectorAll<HTMLElement>(".gallery").forEach(setupGallery);
</script>
