---
import { models } from "../data/models";
import { siteInfo } from "../data/site";

// El navbar solo muestra la primera palabra de cada modelo (ej. "Mobi" en
// vez de "Mobi Trekking") -- pedido del cliente el 2026-09-05, el cintillo
// se veia demasiado largo con el nombre completo de cada version. El
// titulo dentro de cada seccion (ModelSection/AbarthSection) sigue usando
// model.name completo, sin recortar.
const modelLinks = models.map((m) => ({ href: `#${m.slug}`, label: m.name.split(" ")[0] }));
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur border-b border-neutral-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/images/logo-fiat.png" alt={`${siteInfo.brand} ${siteInfo.businessName}`} class="h-9 w-9" />
      <span class="font-semibold text-ink hidden sm:inline">{siteInfo.businessName}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 text-sm text-ink-soft overflow-x-auto">
      {modelLinks.map((link) => (
        <a href={link.href} class="hover:text-accent transition-colors whitespace-nowrap">{link.label}</a>
      ))}
      <a href="#cotizacion" class="hover:text-accent transition-colors whitespace-nowrap">Cotización</a>
      <a href="#servicio" class="hover:text-accent transition-colors whitespace-nowrap">Servicio</a>
      <a href="#contacto" class="hover:text-accent transition-colors whitespace-nowrap">Contacto</a>
    </nav>

    <a
      href="#cotizacion"
      class="hidden lg:inline-flex items-center rounded-full bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark transition-colors shrink-0"
    >
      Cotizar ahora
    </a>

    <button
      id="mobile-menu-button"
      class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-ink"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="lg:hidden hidden flex-col gap-1 border-t border-neutral-200 bg-white px-4 py-3">
    {modelLinks.map((link) => (
      <a href={link.href} class="block py-2 text-ink-soft">{link.label}</a>
    ))}
    <a href="#cotizacion" class="block py-2 text-ink-soft">Cotización</a>
    <a href="#servicio" class="block py-2 text-ink-soft">Servicio</a>
    <a href="#contacto" class="block py-2 text-ink-soft">Contacto</a>
  </nav>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  button?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
    button.setAttribute("aria-expanded", String(!isOpen));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      button?.setAttribute("aria-expanded", "false");
    })
  );
</script>
