---
const heroHeadline = "Turín Motors: Spinti Dalla Passione";
const heroSubtext = "Descubre la variedad de modelos disponibles: el clásico italiano con financiamiento a tu medida.";
---

<section class="pt-32 pb-16 sm:pt-40 sm:pb-24 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm font-medium tracking-wide text-accent uppercase mb-3">Concesionario FIAT Autorizado</p>
    <h1 class="text-3xl sm:text-5xl font-bold text-ink leading-tight">{heroHeadline}</h1>
    <p class="mt-4 text-lg text-ink-soft max-w-2xl mx-auto">{heroSubtext}</p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="#modelos"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-full border border-ink px-6 py-3 font-medium text-ink hover:bg-ink hover:text-white transition-colors"
      >
        Ver modelos
      </a>
      <a
        href="#cotizacion"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 font-medium text-white hover:bg-accent-dark transition-colors"
      >
        Cotizar ahora
      </a>
    </div>
  </div>
</section>
