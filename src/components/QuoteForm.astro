---
import { siteInfo } from "../data/site";
import { models } from "../data/models";

// El ID de Formspree se lee de la variable de entorno (mismo patrón que el
// resto de formularios del sitio). Nunca se hardcodea en el código.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_QUOTE_ID ?? "";
const endpoint = formspreeId ? `https://formspree.io/f/${formspreeId}` : "";

// Colores por modelo (solo 4 de 8 modelos los tienen todavía, ver TODO en
// src/data/models.ts) -- el selector de color se llena dinámicamente según
// el modelo elegido, igual que en el sitio de Kaiyi.
const modelOptions = models.map((m) => ({
  name: m.name,
  colors: (m.colores ?? []).map((c) => c.name),
}));
---

<div class="rounded-2xl bg-white p-5 shadow-lg sm:p-8 border border-neutral-200">
  <h3 class="text-xl font-bold text-ink sm:text-2xl">1. Solicitar cotización</h3>
  <p class="mt-2 text-sm text-ink-soft">Completa tus datos y un asesor te contactará a la brevedad.</p>
  <p class="mt-1 text-sm font-semibold text-accent">{siteInfo.responseTimePromise}</p>

  <form id="quote-form" class="mt-6 space-y-5" data-endpoint={endpoint} novalidate>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="qf-name" class="mb-1 block text-sm font-medium text-ink">
          Nombre completo <span class="text-accent" aria-hidden="true">*</span>
        </label>
        <input id="qf-name" name="nombre" type="text" required autocomplete="name"
          class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" />
      </div>
      <div>
        <label for="qf-email" class="mb-1 block text-sm font-medium text-ink">
          Correo electrónico <span class="text-accent" aria-hidden="true">*</span>
        </label>
        <input id="qf-email" name="email" type="email" required autocomplete="email"
          class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" />
      </div>
      <div>
        <label for="qf-phone" class="mb-1 block text-sm font-medium text-ink">
          Teléfono <span class="text-accent" aria-hidden="true">*</span>
        </label>
        <input id="qf-phone" name="telefono" type="tel" required autocomplete="tel" placeholder="+58 424 0000000"
          class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20" />
      </div>
      <div>
        <label for="qf-model" class="mb-1 block text-sm font-medium text-ink">
          Modelo de interés <span class="text-accent" aria-hidden="true">*</span>
        </label>
        <select id="qf-model" name="modelo" required
          class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20">
          <option value="" disabled selected>Selecciona un modelo</option>
          {modelOptions.map((option) => <option value={option.name}>FIAT {option.name}</option>)}
        </select>
      </div>
      <div>
        <label for="qf-color" class="mb-1 block text-sm font-medium text-ink">Color del vehículo</label>
        <select id="qf-color" name="color" disabled
          class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20 disabled:bg-neutral-100 disabled:text-neutral-400">
          <option value="" selected>Primero elige un modelo</option>
        </select>
      </div>
    </div>

    <div>
      <label for="qf-message" class="mb-1 block text-sm font-medium text-ink">Mensaje</label>
      <textarea id="qf-message" name="mensaje" rows="4" placeholder="Cuéntanos qué opción de financiamiento te interesa…"
        class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/20"></textarea>
    </div>

    <button type="submit"
      class="w-full rounded-full bg-accent px-8 py-3.5 font-bold text-white transition hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-60">
      Enviar solicitud
    </button>

    <p id="quote-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700" role="alert">
      No pudimos enviar tu solicitud. Intenta de nuevo o escríbenos por WhatsApp ({siteInfo.whatsapp}).
    </p>
  </form>
</div>

<script type="application/json" id="qf-model-colors" set:html={JSON.stringify(modelOptions)} />

<script>
  import { supabase } from "../lib/supabase";

  interface ModelOption { name: string; colors: string[] }

  const modelSel = document.getElementById("qf-model") as HTMLSelectElement | null;
  const colorSel = document.getElementById("qf-color") as HTMLSelectElement | null;
  const dataEl = document.getElementById("qf-model-colors");

  if (modelSel && colorSel && dataEl) {
    const options = JSON.parse(dataEl.textContent ?? "[]") as ModelOption[];

    modelSel.addEventListener("change", () => {
      const option = options.find((o) => o.name === modelSel.value);
      colorSel.innerHTML = "";
      if (!option || option.colors.length === 0) {
        colorSel.disabled = true;
        colorSel.append(new Option("Sin colores disponibles todavía", "", true, true));
        return;
      }
      colorSel.disabled = false;
      colorSel.append(new Option("Selecciona un color", "", true, true));
      colorSel.options[0].disabled = true;
      option.colors.forEach((name) => colorSel.append(new Option(name, name)));
    });
  }

  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const errorMsg = document.getElementById("quote-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const endpoint = form.dataset.endpoint;
    const formData = new FormData(form);

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    errorMsg?.classList.add("hidden");

    // Mismo patrón que el resto de formularios: se guarda en Supabase (tabla
    // `solicitudes`) y se envía a Formspree en paralelo; con que uno de los
    // dos funcione, el lead no se pierde.
    const supabaseInsert = supabase.from("solicitudes").insert({
      nombre: formData.get("nombre"),
      correo: formData.get("email"),
      telefono: formData.get("telefono"),
      modelo: formData.get("modelo"),
      color: formData.get("color") || null,
      mensaje: formData.get("mensaje") || null,
    });

    const formspreeSubmit = endpoint
      ? fetch(endpoint, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        }).then((response) => {
          if (!response.ok) throw new Error(`Formspree respondió ${response.status}`);
        })
      : Promise.reject(new Error("PUBLIC_FORMSPREE_QUOTE_ID no configurado"));

    const [supabaseResult, formspreeResult] = await Promise.allSettled([supabaseInsert, formspreeSubmit]);

    if (supabaseResult.status === "rejected") {
      console.error("Error guardando la solicitud en Supabase:", supabaseResult.reason);
    } else if (supabaseResult.value.error) {
      console.error("Error guardando la solicitud en Supabase:", supabaseResult.value.error);
    }
    if (formspreeResult.status === "rejected") {
      console.error("Error enviando la solicitud a Formspree:", formspreeResult.reason);
    }

    const okSupabase = supabaseResult.status === "fulfilled" && !supabaseResult.value.error;
    const okFormspree = formspreeResult.status === "fulfilled";

    if (okSupabase || okFormspree) {
      window.location.href = "/gracias";
      return;
    }

    errorMsg?.classList.remove("hidden");
    if (button) button.disabled = false;
  });
</script>
