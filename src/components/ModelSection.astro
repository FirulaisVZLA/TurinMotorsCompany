---
import type { ModelData } from "../data/models";
import Gallery from "./Gallery.astro";
import SpecVersions from "./SpecVersions.astro";
import SpecVersionTabs from "./SpecVersionTabs.astro";

interface Props {
  model: ModelData;
  reverse?: boolean;
}

const { model, reverse = false } = Astro.props;
const hasMultipleVersions = !!model.versions && model.versions.length > 1;
---

<section id={model.slug} class="scroll-mt-20 py-16 px-4 sm:px-6 lg:px-8 border-t border-neutral-200">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-6">FIAT {model.name}</h2>

    <!-- Galeria y fichas de un lado, Seguridad/Garantia/Especificaciones del
         otro -- alterna izquierda/derecha modelo por modelo (prop `reverse`)
         para que la pagina no se vea siempre igual. Solo Abarth queda
         centrado aparte, en AbarthSection.astro. -->
    <div class="grid gap-8 lg:grid-cols-2 items-start">
      <div class:list={[reverse ? "lg:order-2" : "lg:order-1"]}>
        {hasMultipleVersions && <SpecVersionTabs id={model.slug} versions={model.versions!} />}

        {hasMultipleVersions ? (
          model.versions!.map((v, i) => (
            <div class="version-panel" class:list={[i === 0 ? "block" : "hidden"]} data-content-for={model.slug} data-index={i}>
              <Gallery id={`${model.slug}-v${i}`} images={v.gallery ?? model.gallery} />
            </div>
          ))
        ) : (
          <Gallery id={model.slug} images={model.gallery} />
        )}

        {model.fichaTecnicaPdf ? (
          <a
            href={model.fichaTecnicaPdf}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent-yellow px-5 py-2.5 text-sm font-medium text-ink shadow-sm hover:brightness-95 transition-[filter]"
          >
            Descargar ficha técnica (PDF)
          </a>
        ) : (
          <p class="mt-6 text-sm text-ink-soft italic">Ficha técnica en PDF: pendiente (el cliente no la ha proporcionado todavía).</p>
        )}
      </div>

      <div class:list={[reverse ? "lg:order-1" : "lg:order-2"]}>
        <div class="divide-y divide-neutral-200 rounded-xl border border-neutral-200 bg-white shadow-sm">
          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-ink">
              Seguridad
              <span class="text-ink-soft transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="mt-3 text-ink-soft text-sm">
              {model.seguridad && model.seguridad.length > 0 ? (
                <ul class="list-disc pl-5 space-y-1">
                  {model.seguridad.map((item) => <li>{item}</li>)}
                </ul>
              ) : (
                <p class="italic">Pendiente: el cliente no ha proporcionado el detalle de seguridad de este modelo.</p>
              )}
            </div>
          </details>

          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-ink">
              Garantía
              <span class="text-ink-soft transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="mt-3 text-ink-soft text-sm">
              {model.garantia ? (
                <p>{model.garantia}</p>
              ) : (
                <p class="italic">Pendiente: falta el texto legal de garantía de este modelo.</p>
              )}
            </div>
          </details>

          {model.versions && model.versions.length > 0 && (
            <details class="group px-5 py-4">
              <summary class="flex cursor-pointer items-center justify-between font-medium text-ink">
                {hasMultipleVersions ? "Versiones y especificaciones" : "Especificaciones"}
                <span class="text-ink-soft transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="mt-3">
                <SpecVersions id={model.slug} versions={model.versions} />
              </div>
            </details>
          )}
        </div>
      </div>
    </div>

    <div class="mt-8 rounded-xl border border-neutral-200 bg-white p-5 shadow-sm">
      <h3 class="text-lg font-semibold text-ink mb-3">Carta de colores</h3>
      {model.colores && model.colores.length > 0 ? (
        <div class="grid sm:grid-cols-2 gap-6">
          {model.colores.map((c) => (
            <div class="flex items-center gap-3">
              {c.image && <img src={c.image} alt={c.name} class="h-16 w-24 object-cover rounded" />}
              <div class="flex items-center gap-2">
                <span class="h-4 w-4 rounded-full border border-neutral-300" style={`background:${c.hex}`}></span>
                <span class="text-sm text-ink">
                  {c.name} <span class="text-ink-soft">({c.hex})</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ink-soft italic">Pendiente: falta la carta de colores (nombre, código hex y foto) de este modelo.</p>
      )}
    </div>

    <a href="#cotizacion" class="mt-10 inline-flex items-center gap-1 text-accent font-medium hover:text-accent-dark transition-colors">
      ¿Te interesa el {model.name}? Cotízalo aquí →
    </a>
  </div>
</section>
