---
import type { ModelVersion } from "../data/models";

interface Props {
  id: string;
  versions: ModelVersion[];
  dark?: boolean;
}

const { id, versions, dark = false } = Astro.props;
---

{versions.length > 1 && (
  <div class="spec-version-tabs mb-3 flex flex-wrap gap-2" data-tabs-for={id}>
    {versions.map((v, i) => (
      <button
        type="button"
        class="spec-version-btn rounded-full border px-4 py-1.5 text-sm font-medium transition-colors"
        class:list={
          dark
            ? [i === 0 ? "bg-abarth-yellow text-abarth-bg border-abarth-yellow" : "border-white/30 text-white/70 hover:border-abarth-yellow"]
            : [i === 0 ? "bg-ink text-white border-ink" : "border-neutral-300 text-ink-soft hover:border-ink"]
        }
        data-index={i}
      >
        {v.name}
      </button>
    ))}
  </div>
)}

<script>
  // Los botones de version viven arriba de la galeria (pedido del cliente
  // el 2026-09-03, mejora la estetica), pero controlan la tabla de specs
  // que esta mas abajo en SpecVersions.astro -- se enlazan por el mismo
  // `id` (model.slug) via data-tabs-for / data-content-for, no por
  // anidamiento en el DOM.
  function setupSpecVersionTabs(tabsEl: HTMLElement) {
    const id = tabsEl.dataset.tabsFor;
    const content = document.querySelector<HTMLElement>(`[data-content-for="${id}"]`);
    if (!content) return;

    const btns = Array.from(tabsEl.querySelectorAll<HTMLButtonElement>(".spec-version-btn"));
    const tables = Array.from(content.querySelectorAll<HTMLElement>(".spec-table"));
    const dark = tabsEl.closest(".abarth-gallery") !== null;

    const activeClasses = dark
      ? ["bg-abarth-yellow", "text-abarth-bg", "border-abarth-yellow"]
      : ["bg-ink", "text-white", "border-ink"];
    const inactiveClasses = dark
      ? ["border-white/30", "text-white/70"]
      : ["border-neutral-300", "text-ink-soft"];

    btns.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        btns.forEach((b, i) => {
          const isActive = i === idx;
          activeClasses.forEach((c) => b.classList.toggle(c, isActive));
          inactiveClasses.forEach((c) => b.classList.toggle(c, !isActive));
        });
        tables.forEach((t, i) => {
          t.classList.toggle("hidden", i !== idx);
          t.classList.toggle("block", i === idx);
        });
      });
    });
  }

  document.querySelectorAll<HTMLElement>(".spec-version-tabs").forEach(setupSpecVersionTabs);
</script>
