---
import type { ModelData } from "../data/models";
import Gallery from "./Gallery.astro";

interface Props {
  model: ModelData;
}

const { model } = Astro.props;
---

<section id="abarth" class="bg-abarth-bg text-white">
  <!-- Quiebre de tono pedido por el cliente: al bajar de Toro (paleta clara
       FIAT) a Abarth, la página cambia a la paleta negro/amarillo/rojo del
       logo Abarth y abre con el video de la carpeta del cliente de fondo. -->
  <div class="relative flex min-h-[70vh] items-center justify-center overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src="/videos/abarth-background.mp4"
      autoplay
      muted
      loop
      playsinline
    ></video>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-abarth-bg/30 to-abarth-bg"></div>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl abarth-gallery">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-6">FIAT Abarth</h2>
      <Gallery id={model.slug} images={model.gallery} />

      {model.videos && model.videos.length > 0 && (
        <div class="mt-8">
          <h3 class="text-lg font-semibold text-white mb-3">Características destacadas</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {model.videos.map((v) => (
              <div>
                <video src={v.src} controls class="w-full rounded-lg bg-black aspect-video"></video>
                <p class="mt-2 text-sm text-white/70">{v.description}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {model.fichaTecnicaPdf ? (
        <a
          href={model.fichaTecnicaPdf}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-abarth-yellow px-5 py-2.5 text-sm font-medium text-abarth-bg shadow-sm hover:brightness-95 transition-[filter]"
        >
          Descargar ficha técnica (PDF)
        </a>
      ) : (
        <p class="mt-8 text-sm text-white/60 italic">Ficha técnica en PDF: pendiente (el cliente no la ha proporcionado todavía).</p>
      )}

      <div class="mt-8 divide-y divide-white/15 rounded-xl border border-white/15 bg-white/5">
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-white">
            Seguridad
            <span class="text-white/60 transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 text-white/70 text-sm">
            {model.seguridad && model.seguridad.length > 0 ? (
              <ul class="list-disc pl-5 space-y-1">{model.seguridad.map((item) => <li>{item}</li>)}</ul>
            ) : (
              <p class="italic">Pendiente: el cliente no ha proporcionado el detalle de seguridad de este modelo.</p>
            )}
          </div>
        </details>

        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-white">
            Garantía
            <span class="text-white/60 transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 text-white/70 text-sm">
            {model.garantia ? (
              <p>{model.garantia}</p>
            ) : (
              <p class="italic">Pendiente: falta el texto legal de garantía de este modelo.</p>
            )}
          </div>
        </details>
      </div>

      <div class="mt-8 rounded-xl border border-white/15 bg-white/5 p-5">
        <h3 class="text-lg font-semibold text-white mb-3">Carta de colores</h3>
        {model.colores && model.colores.length > 0 ? (
          <div class="grid sm:grid-cols-2 gap-6">
            {model.colores.map((c) => (
              <div class="flex items-center gap-3">
                {c.image && <img src={c.image} alt={c.name} class="h-16 w-24 object-cover rounded" />}
                <div class="flex items-center gap-2">
                  <span class="h-4 w-4 rounded-full border border-white/30" style={`background:${c.hex}`}></span>
                  <span class="text-sm text-white">
                    {c.name} <span class="text-white/60">({c.hex}{c.approximate && " aprox."})</span>
                  </span>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-white/60 italic">Pendiente: falta la carta de colores (nombre, código hex y foto) de este modelo.</p>
        )}
        {model.colores?.some((c) => c.approximate) && (
          <p class="mt-3 text-xs text-white/60 italic">
            Colores aproximados a partir del nombre oficial de Fiat, pendiente confirmar el código exacto de fábrica.
          </p>
        )}
      </div>

      <a
        href="#cotizacion"
        class="mt-10 inline-flex items-center gap-1 text-abarth-yellow font-medium hover:text-white transition-colors"
      >
        ¿Te interesa el Abarth? Cotízalo aquí →
      </a>
    </div>
  </div>
</section>

<style>
  /* El borde de foto/miniatura activa de Gallery.astro usa border-accent
     (rosa de FIAT) por defecto; dentro de la sección Abarth se reemplaza
     por el amarillo del logo para no chocar con la paleta negro/amarillo/rojo. */
  .abarth-gallery :global(.border-accent) {
    border-color: var(--color-abarth-yellow) !important;
  }
</style>
