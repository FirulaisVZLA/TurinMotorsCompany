---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
// AboutUs (Sobre Nosotros) quitado a pedido del cliente el 2026-08-26 --
// el componente sigue en src/components/AboutUs.astro, pendiente el texto
// institucional exacto. Recordar reactivarlo cuando el cliente lo envíe.
import ModelSection from "../components/ModelSection.astro";
import AbarthTransition from "../components/AbarthTransition.astro";
import AbarthSection from "../components/AbarthSection.astro";
import ServiceAppointment from "../components/ServiceAppointment.astro";
import Quote from "../components/Quote.astro";
import Testimonials from "../components/Testimonials.astro";
import StubSection from "../components/StubSection.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCta from "../components/StickyMobileCta.astro";
import { models } from "../data/models";

// Abarth es "sección especial" (tono oscuro + video de fondo), separada del
// resto de modelos que comparten el ModelSection claro -- ver AbarthSection.astro.
const regularModels = models.filter((m) => m.slug !== "abarth");
const abarthModel = models.find((m) => m.slug === "abarth")!;
---

<BaseLayout
  title="Turín Motors — Concesionario FIAT en Maturín, Monagas"
  description="Turín Motors, concesionario oficial FIAT en Maturín, Monagas, Venezuela. Modelos, cotización y servicio técnico."
>
  <Header />
  <main>
    <Hero />

    <div id="modelos">
      {regularModels.map((model, i) => <ModelSection model={model} reverse={i % 2 === 1} />)}
    </div>
    <AbarthTransition />
    <AbarthSection model={abarthModel} />

    <Quote />

    <ServiceAppointment />

    <Testimonials />

    <StubSection
      id="faq"
      title="Preguntas Frecuentes"
      note="Sección en construcción: pendiente que el cliente envíe las preguntas y respuestas reales."
    />

    <Contact />
  </main>
  <Footer />
  <StickyMobileCta />
</BaseLayout>
