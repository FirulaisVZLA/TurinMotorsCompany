---
import "../styles/global.css";
import { siteInfo } from "../data/site";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import DecorativeBackground from "../components/DecorativeBackground.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Imagen para vista previa al compartir el link (og:image/twitter:image):
// logo de Abarth a pedido del cliente el 2026-08-27, en vez del logo FIAT.
// TODO: reemplazar por una imagen OG dedicada 1200x630 si el cliente
// consigue una (ver lección en el sitio de Kaiyi: recortar con sharp
// anclando al borde que tenga el contenido importante); por ahora es el
// logo de Abarth tal cual (1920x1080, se recorta un poco en algunas redes).
const ogImage = new URL("/images/abarth-logo.png", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo-fiat.png" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutomotiveBusiness",
      name: siteInfo.businessName,
      description: `Concesionario ${siteInfo.brand} en ${siteInfo.city}, ${siteInfo.state}, ${siteInfo.country}.`,
      url: Astro.site,
      image: ogImage,
      address: {
        "@type": "PostalAddress",
        streetAddress: siteInfo.addressText,
        addressLocality: siteInfo.city,
        addressRegion: siteInfo.state,
        addressCountry: "VE",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: siteInfo.mapsLat,
        longitude: siteInfo.mapsLng,
      },
      telephone: siteInfo.whatsapp,
      ...(siteInfo.openingHours
        ? {
            openingHoursSpecification: [
              {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: siteInfo.openingHours.days,
                opens: siteInfo.openingHours.morning.opens,
                closes: siteInfo.openingHours.morning.closes,
              },
              {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: siteInfo.openingHours.days,
                opens: siteInfo.openingHours.afternoon.opens,
                closes: siteInfo.openingHours.afternoon.closes,
              },
            ],
          }
        : {}),
      sameAs: [siteInfo.social.instagram, siteInfo.social.tiktok].filter(Boolean),
    })} />
  </head>
  <body class="font-sans">
    <div class="relative">
      <DecorativeBackground />
      <slot />
    </div>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
